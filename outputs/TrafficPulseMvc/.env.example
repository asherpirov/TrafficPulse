# Copy to .env and set your own values. Do not commit .env.
MYSQL_DATABASE=trafficpulse
MYSQL_USER=trafficapp
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
