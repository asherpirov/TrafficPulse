@model List<Road>
@{ ViewData["Title"] = "ניהול מקטעים"; }
<div class="page-heading"><div><span class="eyebrow">ניהול</span><h1>מקטעי כביש</h1><p class="muted">הגדירו נקודות למעקב וסף רגישות לזיהוי חריגות.</p></div><a class="button primary" asp-action="EditRoad">+ הוספת מקטע</a></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>שם</th><th>קו רוחב</th><th>קו אורך</th><th>סף סטיות תקן</th><th>פעיל</th><th>פעולה</th></tr></thead><tbody>
@foreach (var road in Model) { <tr><td>@road.Name</td><td>@road.Latitude</td><td>@road.Longitude</td><td>@road.SigmaThreshold</td><td>@(road.IsActive ? "כן" : "לא")</td><td><a asp-action="EditRoad" asp-route-id="@road.Id">עריכה</a></td></tr> }
</tbody></table></div>@if (Model.Count == 0) { <p class="empty">עדיין אין מקטעים. הוסיפו את המקטע הראשון.</p> }</section>
